---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import { Icon } from '../components/ui/icons.jsx';
import { contact } from '../data/contact.js';
---

<BaseLayout title="Portal de Clientes | Grupo TSC" description="Ingresá al Portal de Clientes de Grupo TSC para crear y hacer seguimiento de tus tickets de soporte." noindex>
  <Navbar />
  <main>
    <section class="hero-grid relative flex min-h-screen items-center justify-center overflow-hidden px-5 py-32" aria-label="Portal de Clientes">
      <div class="glass-card mx-auto w-full max-w-md p-8 text-center sm:p-10">
        <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl border border-accent/20 bg-gradient-to-br from-accent/15 to-sky-900/5 text-accent transition-all duration-300 hover:-rotate-3 hover:scale-105 hover:border-accent hover:bg-accent hover:text-ink-900">
          <Icon name="ticket" size={26} />
        </div>

        <span class="section-kicker mb-4">Portal de Clientes</span>
        <h1 class="mb-2 mt-4 text-2xl font-bold text-slate-50 sm:text-3xl">Crear Ticket</h1>
        <p class="mb-8 text-sm text-muted">Ingresá con tu cuenta para crear y hacer seguimiento de tus solicitudes de soporte.</p>

        <form id="login-form" class="flex flex-col gap-4 text-left">
          <div>
            <label for="login-user" class="mb-1.5 block text-sm font-semibold text-slate-200">Usuario o email</label>
            <div class="flex items-center gap-2.5 rounded-lg border border-white/10 bg-white/[0.03] px-3.5 py-2.5 transition-colors focus-within:border-accent">
              <Icon name="user" size={16} className="shrink-0 text-muted" />
              <input id="login-user" name="user" type="text" autocomplete="username" required class="w-full bg-transparent text-sm text-slate-50 outline-none placeholder:text-muted" placeholder="nombre@empresa.com" />
            </div>
          </div>

          <div>
            <label for="login-pass" class="mb-1.5 block text-sm font-semibold text-slate-200">Contraseña</label>
            <div class="flex items-center gap-2.5 rounded-lg border border-white/10 bg-white/[0.03] px-3.5 py-2.5 transition-colors focus-within:border-accent">
              <Icon name="lock" size={16} className="shrink-0 text-muted" />
              <input id="login-pass" name="pass" type="password" autocomplete="current-password" required class="w-full bg-transparent text-sm text-slate-50 outline-none placeholder:text-muted" placeholder="••••••••" />
            </div>
          </div>

          <button type="submit" class="btn-primary mt-2 w-full">Ingresar</button>
        </form>

        <div id="login-notice" class="mt-6 hidden rounded-xl border border-accent/15 bg-accent/[0.05] p-4 text-left text-sm leading-relaxed text-slate-100">
          <p class="mb-3">
            <strong class="text-slate-50">Estamos preparando el Portal de Clientes.</strong>
            Muy pronto vas a poder crear y hacer seguimiento de tus tickets desde acá. Mientras tanto, escribinos y te ayudamos al instante.
          </p>
          <a href={contact.whatsapp.href} target="_blank" rel="noopener" class="btn-secondary w-full !py-2.5 text-sm">
            Escribirnos por WhatsApp
          </a>
        </div>

        <a href="/" class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-accent hover:underline">
          <Icon name="chevronLeft" size={16} /> Volver al inicio
        </a>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppButton />
</BaseLayout>

<style>
  .hero-grid::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(56, 189, 248, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(56, 189, 248, 0.08) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 35%, #000 40%, transparent 80%);
    mask-image: radial-gradient(ellipse 70% 60% at 50% 35%, #000 40%, transparent 80%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-grid > * {
    position: relative;
    z-index: 1;
  }
</style>

<script>
  const form = document.getElementById('login-form');
  const notice = document.getElementById('login-notice');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.classList.add('hidden');
    notice?.classList.remove('hidden');
  });
</script>
