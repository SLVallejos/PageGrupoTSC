---
import { footerLinks } from '../../data/contact.js';
const year = new Date().getFullYear();
---

<footer role="contentinfo" class="flex flex-col items-center gap-5 border-t border-white/5 bg-ink-950 px-5 py-16 text-center">
  <img src="/img/tsc_logo.webp" alt="Grupo TSC" width="320" height="213" class="w-full max-w-[220px] object-contain transition-transform hover:scale-[1.03]" loading="lazy" decoding="async" />

  <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2" aria-label="Links del footer">
    {footerLinks.map((link) => (
      <a href={link.href} class="text-sm text-muted transition-colors hover:text-accent">{link.label}</a>
    ))}
  </nav>

  <p class="max-w-md text-sm text-muted">Infraestructura tecnológica para empresas que no pueden permitirse fallas.</p>
  <p class="text-sm text-muted">&copy; {year} Grupo TSC &mdash; Córdoba, Argentina. Todos los derechos reservados.</p>
</footer>
