---
import { navLinks, navCta, ticketCta } from '../../data/nav.js';
import { Icon } from '../ui/icons.jsx';
---

<header id="site-header" class="fixed top-0 left-0 z-[1000] w-full transition-colors duration-300">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3 md:py-3.5" aria-label="Navegación principal">
    <a href="#inicio" class="flex shrink-0 items-center gap-3 text-slate-50" aria-label="Grupo TSC - ir al inicio">
      <img
        src="/img/tsc_logo.webp"
        alt="Grupo TSC"
        width="320"
        height="213"
        class="h-14 w-auto object-contain transition-transform duration-300 hover:scale-105 md:h-16"
        fetchpriority="high"
        decoding="async"
      />
      <span class="hidden text-lg font-bold tracking-wide sm:inline">Grupo TSC</span>
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="relative z-10 flex h-11 w-11 shrink-0 flex-col items-center justify-center gap-[5px] rounded-lg transition-colors hover:bg-white/5 lg:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-principal"
    >
      <span class="hamburger-bar block h-0.5 w-6 rounded-full bg-slate-50"></span>
      <span class="hamburger-bar block h-0.5 w-6 rounded-full bg-slate-50"></span>
      <span class="hamburger-bar block h-0.5 w-6 rounded-full bg-slate-50"></span>
    </button>

    <ul
      id="menu-principal"
      class="menu absolute left-0 top-full hidden w-full flex-col gap-4 rounded-b-2xl border-t border-white/5 bg-ink-950/98 py-6 text-center shadow-lg lg:static lg:flex lg:w-auto lg:flex-row lg:items-center lg:gap-3 lg:border-0 lg:bg-transparent lg:py-0 lg:shadow-none xl:gap-6"
    >
      {navLinks.map((link) => (
        <li><a href={link.href} class="nav-link relative inline-block whitespace-nowrap px-1.5 py-1 font-semibold text-slate-50 transition-colors hover:text-accent xl:px-2">{link.label}</a></li>
      ))}
      <li class="mt-2 lg:ml-1 lg:mt-0">
        <a href={ticketCta.href} class="btn-secondary !px-3.5 !py-2 whitespace-nowrap text-sm xl:!px-4">
          <span class="hidden xl:inline-flex"><Icon name="ticket" size={16} /></span> {ticketCta.label}
        </a>
      </li>
      <li class="mt-2 lg:mt-0"><a href={navCta.href} class="btn-primary !px-4 !py-2 whitespace-nowrap text-sm xl:!px-5 xl:!py-2.5">{navCta.label}</a></li>
    </ul>
  </nav>
</header>

<style>
  .hamburger-bar {
    transition: transform 0.3s ease, opacity 0.2s ease;
  }
  #menu-toggle[aria-expanded='true'] .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #menu-toggle[aria-expanded='true'] .hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  #menu-toggle[aria-expanded='true'] .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-principal');
  const links = menu?.querySelectorAll('a[href^="#"]');

  const setHeaderHeight = () => {
    if (header) document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
  };
  setHeaderHeight();
  window.addEventListener('resize', setHeaderHeight);
  window.addEventListener('load', setHeaderHeight);

  const onScroll = () => {
    if (window.scrollY > 40) {
      header?.classList.add('bg-ink-950/95', 'backdrop-blur-md', 'shadow-lg');
    } else {
      header?.classList.remove('bg-ink-950/95', 'backdrop-blur-md', 'shadow-lg');
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const closeMenu = () => {
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Abrir menú');
    document.body.classList.remove('overflow-hidden');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    if (isOpen) {
      closeMenu();
    } else {
      menu?.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Cerrar menú');
      document.body.classList.add('overflow-hidden');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      toggle.focus();
    }
  });

  links?.forEach((link) => {
    link.addEventListener('click', () => closeMenu());
  });

  const sections = [...document.querySelectorAll('main section[id], section[id]')];
  const navAnchors = [...(links ?? [])];
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navAnchors.forEach((a) => {
          a.classList.remove('text-accent', 'is-active');
          a.removeAttribute('aria-current');
        });
        const match = navAnchors.find((a) => a.getAttribute('href') === `#${entry.target.id}`);
        match?.classList.add('text-accent', 'is-active');
        match?.setAttribute('aria-current', 'true');
      });
    },
    { rootMargin: '-40% 0px -55% 0px' }
  );
  sections.forEach((s) => observer.observe(s));
</script>
