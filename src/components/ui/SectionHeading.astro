---
export interface Props {
  kicker?: string;
  title: string;
  subtitle?: string;
  centered?: boolean;
}
const { kicker, title, subtitle, centered = true } = Astro.props;
---

<div class:list={["mb-10 max-w-2xl reveal", centered && "mx-auto text-center"]}>
  {kicker && <span class="section-kicker mb-4">{kicker}</span>}
  <h2 class="mt-4 text-3xl font-bold text-accent sm:text-4xl">{title}</h2>
  {subtitle && <p class="mx-auto mt-3 max-w-xl text-muted">{subtitle}</p>}
</div>
