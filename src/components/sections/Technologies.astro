---
import { technologies } from '../../data/technologies.js';
import SectionHeading from '../ui/SectionHeading.astro';
import TechTabs from '../islands/TechTabs.jsx';
---

<section id="tecnologias" class="mx-auto max-w-5xl px-5 py-20" aria-label="Tecnologías y soluciones">
  <SectionHeading
    kicker="¿Qué hacemos?"
    title="Nuestras Áreas de Trabajo"
    subtitle="Seleccioná un área para conocer el alcance, los equipos que usamos y qué problema resuelve en tu empresa."
  />
  <TechTabs items={technologies} client:visible />
</section>
