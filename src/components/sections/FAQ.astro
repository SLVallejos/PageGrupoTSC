---
import { faq } from '../../data/faq.js';
import SectionHeading from '../ui/SectionHeading.astro';
import FAQAccordion from '../islands/FAQAccordion.jsx';
---

<section id="faq" class="mx-auto max-w-4xl px-5 py-20" aria-label="Preguntas frecuentes">
  <SectionHeading
    kicker="¿Tenés dudas?"
    title="Preguntas Frecuentes"
    subtitle="Resolvemos las dudas más comunes antes de que solicites tu cotización."
  />
  <FAQAccordion items={faq} client:visible />
</section>
