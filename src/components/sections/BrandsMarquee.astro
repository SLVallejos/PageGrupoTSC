---
import { brands } from '../../data/brands.js';
const looped = [...brands, ...brands];
---

<section id="marcas" class="px-5 py-16" aria-label="Marcas que implementamos">
  <h2 class="reveal mb-10 text-center text-3xl font-bold text-accent sm:text-4xl">Tecnología que Implementamos</h2>

  <div class="carrusel-marcas relative w-full overflow-hidden border-y border-white/5 bg-gradient-to-r from-ink-800/20 to-ink-700/20 py-8" style="mask-image:linear-gradient(to right, transparent 0%, #000 15%, #000 85%, transparent 100%)">
    <div class="marcas-track flex w-max">
      {looped.map((brand) => (
        <div class="flex h-20 w-[200px] items-center justify-center px-9">
          <img
            src={`/img/marcas/${brand.file}`}
            alt={brand.name}
            width={brand.width}
            height={brand.height}
            loading="lazy"
            decoding="async"
            class="max-h-[50px] max-w-full object-contain opacity-40 grayscale brightness-0 invert transition-all duration-300 hover:scale-110 hover:opacity-100 hover:grayscale-0 hover:brightness-100 hover:invert-0"
          />
        </div>
      ))}
    </div>
  </div>
</section>
