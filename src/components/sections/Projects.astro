---
import { projects, projectsHighlights } from '../../data/projects.js';
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectsCarousel from '../islands/ProjectsCarousel.jsx';
---

<section id="proyectos" class="mx-auto max-w-6xl px-5 py-20" aria-label="Proyectos realizados">
  <SectionHeading
    kicker="Implementaciones reales"
    title="Proyectos Realizados"
    subtitle="Casos concretos de infraestructura, seguridad y conectividad desplegados para empresas e instituciones."
  />

  <div class="reveal mx-auto mb-9 grid max-w-3xl gap-4 sm:grid-cols-2">
    {projectsHighlights.map((h) => (
      <div class="glass-card p-6">
        <strong class="mb-2 block text-slate-50">{h.title}</strong>
        <span class="text-sm text-muted">{h.text}</span>
      </div>
    ))}
  </div>

  <ProjectsCarousel items={projects} client:visible />
</section>
