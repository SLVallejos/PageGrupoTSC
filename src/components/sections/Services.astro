---
import { services } from '../../data/services.js';
import SectionHeading from '../ui/SectionHeading.astro';
import { Icon } from '../ui/icons.jsx';
---

<section id="servicios" class="mx-auto max-w-6xl px-5 py-20" aria-label="Servicios">
  <SectionHeading kicker="Lo que hacemos" title="Nuestros Servicios" subtitle="Tres frentes de trabajo, un mismo estándar: infraestructura que funciona y respaldo técnico real." />
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {services.map((s, i) => (
      <div class="glass-card reveal group relative flex flex-col p-8 text-left transition-all duration-300 hover:-translate-y-1.5 hover:border-accent/50 hover:shadow-glow">
        <span class="card-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>

        <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl border border-accent/20 bg-gradient-to-br from-accent/15 to-sky-900/5 text-accent transition-all duration-300 group-hover:-rotate-3 group-hover:scale-105 group-hover:border-accent group-hover:bg-accent group-hover:text-ink-900">
          <Icon name={s.icon} size={26} />
        </div>

        <h3 class="mb-2.5 text-xl font-semibold text-slate-50 transition-colors group-hover:text-accent">{s.title}</h3>
        <p class="mb-5 text-sm leading-relaxed text-muted">{s.intro}</p>

        <ul class="mb-6 flex flex-1 flex-col gap-2.5 border-t border-white/5 pt-5">
          {s.features.map((feature) => (
            <li class="flex items-start gap-2.5 text-sm text-slate-200">
              <Icon name="check" size={15} className="mt-0.5 shrink-0 text-emerald-400" />
              <span>{feature}</span>
            </li>
          ))}
        </ul>

        <a href="#contacto" class="inline-flex items-center gap-2 text-sm font-semibold text-accent transition-transform group-hover:translate-x-1 hover:underline">
          Consultar por este servicio <Icon name="chevronRight" size={16} />
        </a>
      </div>
    ))}
  </div>
</section>
