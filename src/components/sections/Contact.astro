---
import { contact } from '../../data/contact.js';
import SectionHeading from '../ui/SectionHeading.astro';
import { Icon } from '../ui/icons.jsx';
import ContactForm from '../islands/ContactForm.jsx';

const mapQuery = encodeURIComponent(`${contact.location}`);
const mapEmbedSrc = `https://www.google.com/maps?q=${mapQuery}&output=embed`;
---

<section id="contacto" class="mx-auto max-w-6xl px-5 py-20" aria-label="Contacto">
  <SectionHeading title="Hablemos de tu proyecto" subtitle="Contanos qué necesitás y te respondemos en menos de 24 hs con una propuesta sin cargo." />

  <div class="grid gap-8 lg:grid-cols-2">
    <div class="reveal-left glass-card p-8 sm:p-10">
      <h3 class="mb-5 text-2xl font-bold text-accent glow-accent">Grupo TSC</h3>

      <p class="mb-4 flex items-center gap-2.5"><Icon name="phone" size={16} className="text-accent" /> <strong>Teléfono:</strong> <a href={contact.phoneHref} class="text-slate-50 no-underline hover:text-accent hover:underline">{contact.phoneDisplay}</a></p>
      <p class="mb-4 flex items-center gap-2.5"><Icon name="mail" size={16} className="text-accent" /> <strong>Email:</strong> <a href={`mailto:${contact.email}`} class="text-slate-50 no-underline hover:text-accent hover:underline">{contact.email}</a></p>
      <p class="mb-4 flex items-start gap-2.5"><Icon name="mapPin" size={16} className="mt-0.5 shrink-0 text-accent" /> <span><strong>Ubicación:</strong> {contact.location}</span></p>

      <div class="mb-4">
        <p class="mb-1 flex items-center gap-2.5"><Icon name="clock" size={16} className="text-accent" /> <strong>Horario de Atención:</strong></p>
        <ul class="flex flex-col gap-1 pl-7 text-sm">
          {contact.schedule.map((s) => (
            <li><span class="text-muted">{s.label}</span> {s.value}</li>
          ))}
        </ul>
      </div>

      <p class="mb-5 flex items-center gap-2.5 text-sm text-accent">
        <Icon name="alert" size={16} /> {contact.note}
      </p>

      <a
        href={contact.whatsapp.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 rounded-lg border border-[#25d366]/30 bg-[#25d366]/10 px-5 py-3 text-sm font-semibold text-[#25d366] transition-all hover:-translate-y-0.5 hover:bg-[#25d366]/20"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.03c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.12.11-1.81-.11-.42-.13-.95-.31-1.64-.6-2.89-1.25-4.77-4.16-4.92-4.35-.14-.19-1.18-1.57-1.18-3 0-1.43.75-2.13 1.02-2.42.27-.29.58-.36.78-.36.19 0 .39 0 .56.01.18.01.42-.07.65.5.24.58.82 2 .89 2.15.07.14.12.31.02.5-.09.19-.14.31-.28.47-.14.16-.29.36-.42.48-.14.13-.28.28-.12.55.16.27.72 1.19 1.55 1.93 1.06.95 1.96 1.24 2.23 1.38.27.14.43.12.59-.07.16-.19.68-.79.86-1.06.18-.27.36-.22.6-.13.24.09 1.53.72 1.79.85.26.13.44.19.5.3.07.11.07.62-.17 1.3Z"/>
        </svg>
        Escribirnos por WhatsApp
      </a>
    </div>

    <div class="reveal-right glass-card p-8 sm:p-10">
      <ContactForm endpoint={contact.formEndpoint} typeOptions={contact.typeOptions} whatsappHref={contact.whatsapp.href} client:visible />
    </div>
  </div>

  <div class="reveal glass-card mt-8 p-8 sm:p-10">
    <div class="mb-6 flex items-center gap-3.5">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-accent/20 bg-accent/10 text-accent">
        <Icon name="mapPin" size={22} />
      </div>
      <div>
        <h3 class="text-xl font-bold text-slate-50">Nuestra ubicación</h3>
        <p class="text-sm text-muted">Pasaje Juan Ramón Jiménez 1169, Córdoba, Argentina</p>
      </div>
    </div>

    <div class="map-frame">
      <iframe
        src={mapEmbedSrc}
        title="Mapa de ubicación de Grupo TSC en Pasaje Juan Ramón Jiménez 1169, Córdoba"
        class="h-[320px] w-full border-0 sm:h-[380px]"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        aria-label="Mapa interactivo con la ubicación de Grupo TSC"
      ></iframe>
    </div>
  </div>
</section>
