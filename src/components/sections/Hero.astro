---
import { hero } from '../../data/hero.js';
import { Icon } from '../ui/icons.jsx';

const [titleBefore, titleAfter] = hero.title.split(hero.highlight);
---

<section id="inicio" class="hero-grid relative flex min-h-screen items-center justify-center overflow-hidden px-5 pb-20 pt-32 text-center" aria-label="Inicio">
  <video
    id="hero-video"
    class="pointer-events-none absolute inset-0 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
  >
    <source src="/video/hero-tunnel-720.mp4" media="(min-width: 768px)" type="video/mp4" />
    <source src="/video/hero-tunnel-360.mp4" type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-ink-900/80" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_50%_45%,rgba(6,13,26,0.75)_0%,transparent_75%)]" aria-hidden="true"></div>

  <div class="mx-auto max-w-4xl">
    <span class="section-kicker reveal mb-6"><Icon name="shield" size={16} /> {hero.badge}</span>

    <h1 class="reveal mb-5 text-[clamp(2.5rem,5vw,4.6rem)] font-bold leading-tight [text-shadow:0_2px_20px_rgba(0,0,0,0.7)]">
      {titleBefore}<span class="bg-gradient-to-r from-accent to-accent-light bg-clip-text text-transparent">{hero.highlight}</span>{titleAfter}
    </h1>

    <p class="reveal mx-auto mb-9 max-w-3xl rounded-xl bg-ink-900/45 px-4 py-3 text-[clamp(1rem,1.4vw,1.2rem)] leading-relaxed text-slate-100 backdrop-blur-sm [text-shadow:0_1px_3px_rgba(0,0,0,0.9)]">
      {hero.description}
    </p>

    <div class="reveal mb-4 flex flex-wrap justify-center gap-4">
      <a href={hero.primaryCta.href} class="btn-primary w-full max-w-xs sm:w-auto">{hero.primaryCta.label}</a>
      <a href={hero.secondaryCta.href} class="btn-secondary w-full max-w-xs sm:w-auto">{hero.secondaryCta.label}</a>
    </div>
    <p class="reveal mb-10 flex items-center justify-center gap-2 text-sm text-muted">
      <Icon name="check" size={14} className="text-emerald-400" /> {hero.ctaNote}
    </p>

    <div class="reveal mb-10 flex flex-wrap justify-center gap-3">
      {hero.chips.map((chip) => (
        <div class="flex items-center gap-2 rounded-full border border-slate-400/10 bg-ink-800/70 px-4 py-3 text-sm font-semibold text-accent">
          <Icon name={chip.icon} size={16} /> {chip.label}
        </div>
      ))}
    </div>

    <div class="reveal flex flex-wrap justify-center gap-10 border-t border-slate-400/20 pt-8">
      {hero.stats.map((stat) => (
        <div class="min-w-[130px]">
          <h3 class="stat-num text-3xl font-bold text-accent" data-target={stat.target} data-prefix={stat.prefix} data-suffix={stat.suffix}>
            {stat.prefix}{stat.target}{stat.suffix}
          </h3>
          <span class="text-sm text-muted">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>

  <a
    href="#nosotros"
    aria-label="Desplazarse a la siguiente sección"
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-1 text-muted transition-colors hover:text-accent motion-safe:animate-bounce sm:flex"
  >
    <Icon name="chevronDown" size={22} />
  </a>
</section>

<style>
  .hero-grid > *:not(video) {
    position: relative;
    z-index: 1;
  }
  #hero-video {
    z-index: 0;
  }
</style>

<script>
  const video = document.getElementById('hero-video');

  if (video instanceof HTMLVideoElement) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      video.removeAttribute('autoplay');
      video.pause();
    }
  }
</script>
