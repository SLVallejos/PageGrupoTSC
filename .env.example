APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=grupotsc
DB_USERNAME=grupotsc_app
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Conexión de solo lectura a la base de datos de FreeScout, para validar el
# login de administradores contra su tabla `users` (ver
# docs/freescout-integration-strategy.md). El usuario de MySQL solo debe
# tener GRANT SELECT sobre freescout.users, nunca más que eso.
FREESCOUT_DB_HOST=127.0.0.1
FREESCOUT_DB_PORT=3306
FREESCOUT_DB_DATABASE=freescout
FREESCOUT_DB_USERNAME=grupotsc_app
FREESCOUT_DB_PASSWORD=
FREESCOUT_DB_CHARSET=utf8mb4
